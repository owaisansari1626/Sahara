# Sahara Mental Health FastAPI Backend Configuration

# Optional: Google Gemini API Key for LangChain model layer
# If omitted, the server automatically uses a safe contextual rule-based fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000

# SQLite Database Location
DATABASE_FILE=backend/sahara.db

# Admin API Secret Key for protected analytics and management endpoints
ADMIN_SECRET_KEY=sahara-admin-secret-2025
